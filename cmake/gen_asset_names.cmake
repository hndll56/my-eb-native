# Usage: cmake -DIDS=asset_ids.h -DOUT=asset_names.inc.c -P gen_asset_names.cmake
# Turns the "/* relative/path */" comments of the generated asset enum into a runtime name table.
file(STRINGS ${IDS} _lines REGEX "^    ASSET_[A-Z0-9_]+, /\\* .* \\*/$")
set(_out "/* generated by cmake/gen_asset_names.cmake */\nconst char *const asset_names[] = {\n")
set(_n 0)
foreach(_l IN LISTS _lines)
    string(REGEX REPLACE "^.*/\\* (.*) \\*/$" "\\1" _p "${_l}")
    string(APPEND _out "    \"${_p}\",\n")
    math(EXPR _n "${_n}+1")
endforeach()
string(APPEND _out "};\nconst int asset_names_count = ${_n};\n")
file(WRITE ${OUT} "${_out}")
